# MT5 Terminal
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Anthropic API (vision pattern reader / challenger)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-sonnet-4-6

# OpenAI API (strict JSON arbitrator / embeddings)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MODEL_ROUTING_POLICY=dual_provider

# Consensus Mode: local (1 API call + file fallback), anthropic (2 Claude calls),
#                  dual-api (Claude + GPT), openai (1 GPT call)
# Auto-detected from API keys if not set.
CONSENSUS_MODE=local

# Risk Parameters
MAX_RISK_PER_TRADE=0.01
MAX_DRAWDOWN_PCT=0.08
MAX_CONCURRENT_POSITIONS=3
DEFAULT_PAIRS=EURUSD,GBPUSD,GBPJPY,USDJPY,EURJPY,GBPCHF,AUDUSD,GBPAUD,GBPNZD,EURGBP,XAUUSD,US30,USTEC
RESEARCH_SYMBOLS=EURUSD,GBPUSD,GBPJPY,USDJPY,EURJPY,GBPCHF,AUDUSD,GBPAUD,GBPNZD,EURGBP,XAUUSD,US30,USTEC
REENTRY_GUARD_BAN_SCOPE=direction

# Chart Export
CHART_OUTPUT_DIR=./charts
CHART_RESOLUTION=1024
CHART_BAR_COUNT=120

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Scanner-first alert-only watchlist
# This command never places, modifies, or closes MT5 orders:
# python -m helix_v3.scanner.watchlist --symbols EURUSD,GBPUSD,GBPJPY,USDJPY,EURJPY,GBPCHF,AUDUSD,GBPAUD,GBPNZD,EURGBP,XAUUSD,US30,USTEC
SCANNER_ALERT_SYMBOLS=EURUSD,GBPUSD,GBPJPY,USDJPY,EURJPY,GBPCHF,AUDUSD,GBPAUD,GBPNZD,EURGBP,XAUUSD,US30,USTEC
SCANNER_ALERT_TIMEFRAME=M15
SCANNER_ALERT_MIN_READINESS=70
SCANNER_ALERT_MAX_AGE_MINUTES=180
SCANNER_ALERT_POLICY=stop_hunt_then_bias
SCANNER_ALERT_REQUIRE_STOP_HUNT=false
SCANNER_ALERT_ALLOW_ANALYSIS_ONLY_PAIRS=true
SCANNER_ALERT_REQUIRE_EXACT_VALIDATION=true
SCANNER_ALERT_MIN_VALIDATION_SCORE=0
SCANNER_ALERT_HISTORICAL_MATCH_LIMIT=3
SCANNER_ALERT_HISTORICAL_MIN_TOTAL=10
SCANNER_ALERT_LIMIT=10
SETUP_INTELLIGENCE_DB=logs/setup_intelligence.db
